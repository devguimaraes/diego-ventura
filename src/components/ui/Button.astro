---
import { buttonVariants } from './button';
import { cn } from '@/lib/utils';

export interface Props {
  variant?: 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive' | 'link';
  size?: 'default' | 'xs' | 'sm' | 'lg' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg';
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'default',
  size = 'default',
  href,
  class: extraClass = '',
  target,
  rel,
  type,
} = Astro.props;
const classes = cn(buttonVariants({ variant, size }), extraClass);
---

{href ? (
  <a href={href} class={classes} data-slot="button" target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button class={classes} data-slot="button" type={type}>
    <slot />
  </button>
)}
