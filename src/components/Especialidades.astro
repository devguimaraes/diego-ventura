---
import { especialidades, contact } from '../data/site.json';

const whatsappHref = `https://wa.me/${contact.whatsapp}`;
---

<section id="especialidades" class="py-section-gap">
  {especialidades.items.map((item, index) => {
    const isReversed = index % 2 === 1;
    const bg = isReversed ? 'bg-background' : 'bg-surface-container-high';
    return (
      <div class={`flex flex-col lg:flex-row ${isReversed ? 'lg:flex-row-reverse' : ''} ${bg} h-auto min-h-[600px]`}>
        <div class="lg:w-1/2 p-12 lg:p-20 flex flex-col justify-center">
          <h3 class="font-manrope text-headline-lg text-primary mb-6">{item.title}</h3>
          <p class="font-manrope text-body-lg text-on-surface-variant/80 mb-10 max-w-md">
            {item.description}
          </p>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="w-fit border-2 border-primary text-primary px-10 py-3 rounded-full font-manrope text-label-md transition-[background-color,color,transform] duration-200 hover:bg-primary hover:text-on-primary active:scale-[0.97]"
          >
            {item.cta}
          </a>
        </div>
        <div class="lg:w-1/2 overflow-hidden min-h-[400px] group">
          <img
            alt={`Dr. Dhiego Ventura - ${item.title}`}
            class="img-hover-zoom w-full h-full object-cover"
            src={item.image}
          />
        </div>
      </div>
    );
  })}
</section>
