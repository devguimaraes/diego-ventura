---
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import { hero, contact } from '../data/site.json';
import heroImg from '../../public/images/hero-diego.jpg';
---

<section id="hero" class="relative min-h-[90vh] flex items-center container-main pt-32 pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">
    <!-- Text content -->
    <div class="z-10 order-2 lg:order-1" data-animate="reveal">
      <span class="text-primary font-bold text-label-sm tracking-[0.2em] uppercase block mb-6">
        {hero.badge}
      </span>
      
      <h1 class="text-display-lg text-foreground mb-8 leading-[1.1]">
        <span class="split-text-line">
          <span class="split-text-content">{hero.headlineLine1.split('VIP')[0]}<span class="text-primary">VIP</span>{hero.headlineLine1.split('VIP')[1]}</span>
        </span>
        <span class="split-text-line">
          <span class="split-text-content text-headline-lg text-foreground/90 mt-2">{hero.headlineLine2}</span>
        </span>
      </h1>

      <p class="text-body-lg text-on-surface-variant/80 mb-4 max-w-xl leading-relaxed">
        {hero.description}
      </p>
      <p class="text-body-md text-on-surface-variant/60 mb-10 max-w-lg">
        {hero.description2}
      </p>

      <div class="flex flex-col items-start gap-3">
        <Button
          href={`https://wa.me/${contact.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          size="lg"
          class="h-auto min-h-12 w-full sm:w-auto max-w-full whitespace-normal px-6 sm:px-10 py-4 text-label-md font-extrabold shadow-luxury hover:shadow-luxury-hover"
        >
          {hero.cta}
          <span class="material-symbols-outlined ml-2 transition-transform duration-200 group-hover/button:translate-x-1">arrow_forward</span>
        </Button>
        
        <div class="flex flex-col gap-1 text-left">
          <span class="text-foreground font-semibold text-lg tracking-tight">{hero.price}</span>
          <span class="text-on-surface-variant/60 text-sm">{hero.priceLabel} · {hero.priceNote}</span>
        </div>
      </div>
    </div>

    <!-- Image -->
    <div class="relative order-1 lg:order-2 flex justify-center lg:justify-end" data-animate="reveal" data-animate-delay="2">
      <div class="absolute inset-0 bg-primary/20 blur-[120px] rounded-full scale-75"></div>
      <div class="relative z-10 w-full max-w-[20rem] sm:max-w-sm lg:max-w-md rounded-[2rem] overflow-hidden shadow-2xl border border-white/5 group">
        <Image
          src={heroImg}
          alt="Dr. Dhiego Ventura - Nutricionista"
          class="hero-image img-hover-zoom w-full h-auto"
          width={660}
          height={1024}
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent opacity-0 transition-opacity duration-200 group-hover:opacity-100"></div>
      </div>
    </div>
  </div>
</section>
